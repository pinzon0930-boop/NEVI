# ============================================================
# NEVI — Variables de entorno
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ── Base de datos PostgreSQL ─────────────────────────────────
DB_NAME=nevi
DB_USER=nevi
DB_PASSWORD=cambia_esta_contraseña

# ── JWT (genera una clave segura aleatoria de 32+ caracteres) ─
JWT_SECRET=cambia_este_secreto_por_uno_seguro_de_32_chars

# ── URLs del backend (para el frontend y WebSocket) ──────────
# En desarrollo local:
VITE_API_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws

# En producción (ejemplo):
# VITE_API_URL=https://api.tudominio.com
# VITE_WS_URL=https://api.tudominio.com/ws

# ── IA: Groq API (se mantiene igual) ─────────────────────────
VITE_GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXX
